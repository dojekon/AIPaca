{
  "schemaVersion": 1,
  "id": "default/hexagon",
  "backend": "hexagon",
  "model": {
    "family": "default",
    "matchPatterns": [".*"],
    "quants": []
  },
  "launch": {
    "nCtx": 4096,
    "threads": 2,
    "ubatchSize": 512,
    "nGpuLayers": 99,
    "flashAttn": true,
    "kvTypeK": "q8_0",
    "kvTypeV": "q8_0",
    "env": {
      "GGML_HEXAGON_DEVICES": "HTP0",
      "GGML_HEXAGON_POWER_MODE": "sustained_high_performance"
    }
  },
  "minAppVersion": "0.1.0",
  "experimental": true
}
